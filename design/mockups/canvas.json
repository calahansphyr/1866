  "notes": {
    "title": {
      "x": 0,
      "y": -300,
      "text": "Three ways to walk the town in 1866",
      "kind": "title1",
      "maxW": 2980,
      "page": "r1"
    },
    "brief": {
      "x": 0,
      "y": -190,
      "w": 860,
      "text": "Same moment in every pair: Spring 1867. You walk the town, talk to people who each want something, and step inside a building to make a money decision. Left screen: the open world. Right screen: an interior. Same ledger everywhere: cash $41, store tab $28 at 3% a month, cellar half full.",
      "page": "r1"
    },
    "mixtitle": {
      "x": 0,
      "y": -300,
      "text": "One season, start to finish",
      "kind": "title1",
      "maxW": 2270,
      "page": "mix"
    },
    "mixrule": {
      "x": 0,
      "y": -190,
      "w": 760,
      "text": "The rule: the world is toy 3D (where you act), anything you read is ink on paper (where you think). The header keeps A's layout: who you are, when it is, cash, tab, cellar jars, visits left as boots.",
      "page": "mix"
    },
    "r3title": {
      "x": 0,
      "y": -300,
      "text": "The outline, on screen",
      "kind": "title1",
      "maxW": 3060,
      "page": "r3"
    },
    "r3brief": {
      "x": 0,
      "y": -190,
      "w": 900,
      "text": "New from the outline: you make your family, Grandma Ruth teaches by asking questions, the Almanac ties each idea to your own run and to today, and family standing carries into the next chapter. The cast sheet sets the look for every character.",
      "page": "r3"
    }
